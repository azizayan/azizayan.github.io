---
const projects = [
  {
    name: 'meetcinema',
    tag: 'desktop / rust',
    blurb:
      'Local, private live captions and meeting notes for any video call. Captures webcam + mic, transcribes on-device with whisper.cpp, burns captions into a virtual camera that Zoom, Meet, Teams, or Discord picks up as a regular webcam. Nothing leaves the machine.',
    stack: ['rust', 'tauri', 'whisper-rs', 'nokhwa', 'cpal'],
    status: '',
    href: 'https://github.com/azizayan/meetcinema',
  },
  {
    name: 'voice agent',
    tag: 'realtime / voice',
    blurb:
      'Interruptible realtime voice agent (codename freya). Browser captures mic over Daily WebRTC; a Pipecat pipeline (Deepgram STT → OpenAI LLM → Cartesia TTS) responds and can be interrupted mid-utterance. Live bot state, round-trip latency, and interruption events stream back over a data channel.',
    stack: ['next.js', 'fastapi', 'pipecat', 'daily.co', 'deepgram', 'cartesia'],
    status: '',
    href: 'https://github.com/azizayan/vagent',
  },
  {
    name: 'paper-review',
    tag: 'cli / llm',
    blurb:
      'AI-powered academic paper reviewer. Feed it an Overleaf URL and get back structured, comment-style findings on the manuscript — the reviewer you wish your co-author was.',
    stack: ['python', 'llm', 'overleaf'],
    status: '',
    href: 'https://github.com/azizayan/paper-review',
  },
  {
    name: 'agentmesh',
    tag: 'multi-agent / local-first',
    blurb: 'Coordination fabric for local agents.',
    stack: [],
    status: '',
    href: 'https://github.com/azizayan/agentmesh',
  },
  {
    name: 'cortex',
    tag: 'workspace / mcp',
    blurb: 'Context-aware workspace agent (daemon + MCP).',
    stack: [],
    status: '',
    href: 'https://github.com/azizayan/cortex',
  },
];

const contacts = [
  { label: 'github',   value: 'azizayan',                          href: 'https://github.com/azizayan' },
  { label: 'email',    value: 'azizayan52@gmail.com',              href: 'mailto:azizayan52@gmail.com' },
  { label: 'x',        value: '@azizemreayan',                     href: 'https://x.com/azizemreayan' },
  { label: 'linkedin', value: 'aziz-emre-ayan',                    href: 'https://www.linkedin.com/in/aziz-emre-ayan' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>azizayan // portfolio</title>
    <meta name="description" content="azizayan — CS / AI-ML enthusiast. Local-first agents, realtime voice, and systems." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E▚%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="scanlines" aria-hidden="true"></div>

    <main class="wrap">
      <header class="head">
        <div class="prompt">
          <span class="user">azizayan</span><span class="at">@</span><span class="host">local</span><span class="colon">:</span><span class="path">~/portfolio</span><span class="dollar">$</span>
          <span class="cmd">cat about.txt</span>
        </div>

        <h1 class="name">
          <span class="bracket">[</span>azizayan<span class="bracket">]</span>
          <span class="cursor" aria-hidden="true">▍</span>
        </h1>

        <p class="tagline">
          <span class="comment">//</span> CS / AI-ML enthusiast
        </p>
      </header>

      <section class="section" id="about">
        <h2 class="h2"><span class="hash">##</span> about</h2>
        <div class="prose">
          <p>
            CS undergrad at <strong>Bilkent University</strong> (2023–present),
            focused on building practical AI and software systems — local-first
            tools, realtime pipelines, and the occasional command-line
            contraption.
          </p>
          <p>
            Currently working on <a href="#projects">meetcinema</a> and a
            couple of coordination experiments
            (<a href="#projects">agentmesh</a>, <a href="#projects">cortex</a>).
          </p>
          <p>
            Outside of code: president of the <em>Bilkent AI Society</em>
            (workshops, conferences, mentorship).
          </p>
        </div>

        <dl class="facts">
          <div><dt>edu</dt><dd>B.Sc. Computer Science, Bilkent University <span class="dim">(2023 – present)</span></dd></div>
          <div><dt>cert</dt><dd>Stanford Code in Place <span class="dim">(2024)</span> · CoderSpace Data Science & AI Summer School <span class="dim">(2024)</span></dd></div>
          <div><dt>role</dt><dd>President, Bilkent AI Society <span class="dim">(2024 – present)</span></dd></div>
          <div><dt>lang</dt><dd>Python <span class="dim">(primary)</span>, Java, C++</dd></div>
          <div><dt>ml</dt><dd>scikit-learn, NumPy, pandas, matplotlib, prompt design, tool routing</dd></div>
          <div><dt>spoken</dt><dd>English, Turkish, German</dd></div>
          <div><dt>cv</dt><dd><a href="/aziz-emre-ayan-cv.pdf" target="_blank" rel="noopener noreferrer">aziz-emre-ayan-cv.pdf ↗</a></dd></div>
        </dl>
      </section>

      <section class="section" id="projects">
        <h2 class="h2"><span class="hash">##</span> projects</h2>
        <ul class="projects">
          {projects.map((p) => (
            <li class="project">
              <a class="project-link" href={p.href} target="_blank" rel="noopener noreferrer">
                <div class="project-head">
                  <span class="project-name">{p.name}</span>
                  <span class="project-tag">{p.tag}</span>
                  {p.status && <span class="project-status" data-status={p.status}>{p.status}</span>}
                </div>
                <p class="project-blurb">{p.blurb}</p>
                {p.stack.length > 0 && (
                  <ul class="stack">
                    {p.stack.map((s) => <li>{s}</li>)}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="section" id="contact">
        <h2 class="h2"><span class="hash">##</span> contact</h2>
        <ul class="contacts">
          {contacts.map((c) => (
            <li class="contact">
              <span class="contact-label">{c.label}</span>
              <span class="contact-sep">=</span>
              <a class="contact-value" href={c.href} target={c.href.startsWith('mailto:') ? '_self' : '_blank'} rel="noopener noreferrer">{c.value}</a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="foot">
        <div class="prompt">
          <span class="user">azizayan</span><span class="at">@</span><span class="host">local</span><span class="colon">:</span><span class="path">~/portfolio</span><span class="dollar">$</span>
          <span class="cmd">exit<span class="cursor" aria-hidden="true">▍</span></span>
        </div>
      </footer>
    </main>

    <style is:global>
      :root {
        --bg: #0a0a0a;
        --bg-2: #111;
        --fg: #d7d7d7;
        --dim: #7a7a7a;
        --muted: #4a4a4a;
        --accent: #7cff6b;
        --accent-2: #ffb86b;
        --warn: #ff6b6b;
        --link: #7cff6b;
        --rule: #1e1e1e;
        --mono: ui-monospace, 'JetBrains Mono', 'Fira Code', 'SF Mono',
          Menlo, Consolas, monospace;
        color-scheme: dark;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body {
        font-family: var(--mono);
        font-size: 15px;
        line-height: 1.6;
        min-height: 100vh;
        background:
          radial-gradient(1200px 600px at 80% -10%, rgba(124,255,107,0.06), transparent 60%),
          radial-gradient(1000px 500px at -10% 20%, rgba(255,184,107,0.04), transparent 60%),
          var(--bg);
      }

      .scanlines {
        position: fixed; inset: 0; pointer-events: none; z-index: 1;
        background: repeating-linear-gradient(
          to bottom,
          rgba(255,255,255,0.015) 0px,
          rgba(255,255,255,0.015) 1px,
          transparent 1px,
          transparent 3px
        );
        mix-blend-mode: overlay;
      }

      .wrap {
        position: relative; z-index: 2;
        max-width: 820px;
        margin: 0 auto;
        padding: 48px 24px 96px;
      }

      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }

      /* Prompt line */
      .prompt {
        color: var(--dim);
        font-size: 13px;
        letter-spacing: 0.02em;
        border: 1px solid var(--rule);
        background: var(--bg-2);
        padding: 8px 12px;
        display: flex; flex-wrap: wrap; gap: 2px;
      }
      .prompt .user { color: var(--accent); }
      .prompt .at { color: var(--dim); }
      .prompt .host { color: var(--accent-2); }
      .prompt .colon, .prompt .dollar { color: var(--dim); }
      .prompt .path { color: #6ba9ff; }
      .prompt .dollar { margin-right: 6px; margin-left: 2px; }
      .prompt .cmd { color: var(--fg); }

      /* Header */
      .head { margin-bottom: 40px; }
      .name {
        font-size: clamp(38px, 8vw, 68px);
        line-height: 1.05;
        margin: 20px 0 4px;
        letter-spacing: -0.02em;
        font-weight: 700;
      }
      .name .bracket { color: var(--dim); font-weight: 400; }
      .cursor {
        display: inline-block;
        color: var(--accent);
        animation: blink 1.1s steps(1, end) infinite;
        transform: translateY(-2px);
      }
      @keyframes blink { 50% { opacity: 0; } }
      .tagline { color: var(--dim); margin: 0; font-size: 15px; }
      .tagline .comment { color: var(--muted); margin-right: 6px; }

      /* Sections */
      .section {
        margin: 44px 0;
        border-top: 1px dashed var(--rule);
        padding-top: 28px;
      }
      .h2 {
        font-size: 14px;
        text-transform: lowercase;
        letter-spacing: 0.08em;
        color: var(--fg);
        margin: 0 0 18px;
        font-weight: 600;
      }
      .h2 .hash { color: var(--accent); margin-right: 8px; }

      .prose p { margin: 0 0 12px; color: var(--fg); }
      .prose p:last-child { margin-bottom: 0; }
      .prose strong { color: var(--accent); font-weight: 600; }
      .prose em { color: var(--accent-2); font-style: normal; }

      /* Facts key-value block */
      .facts {
        margin: 20px 0 0;
        padding: 14px 16px;
        border: 1px solid var(--rule);
        background: var(--bg-2);
        display: grid; gap: 6px;
        font-size: 13px;
      }
      .facts > div { display: flex; gap: 12px; align-items: baseline; }
      .facts dt {
        color: var(--accent);
        min-width: 64px;
        text-transform: lowercase;
        letter-spacing: 0.04em;
      }
      .facts dt::before { content: '·'; margin-right: 6px; color: var(--muted); }
      .facts dd { margin: 0; color: var(--fg); }
      .facts .dim { color: var(--dim); }

      /* Projects */
      .projects { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
      .project { }
      .project-link {
        display: block;
        border: 1px solid var(--rule);
        background: var(--bg-2);
        padding: 16px 18px;
        color: var(--fg);
        transition: border-color .15s ease, transform .15s ease, background .15s ease;
      }
      .project-link:hover {
        border-color: var(--accent);
        background: #0f130f;
        text-decoration: none;
        transform: translateY(-1px);
      }
      .project-head {
        display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px;
        margin-bottom: 6px;
      }
      .project-name {
        color: var(--accent);
        font-weight: 600;
        font-size: 17px;
      }
      .project-tag {
        color: var(--dim);
        font-size: 12px;
        letter-spacing: 0.04em;
      }
      .project-status {
        margin-left: auto;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border: 1px solid var(--muted);
        color: var(--dim);
        padding: 2px 6px;
      }
      .project-status[data-status="under development"] {
        color: var(--accent-2);
        border-color: var(--accent-2);
      }
      .project-status[data-status="shipped"] {
        color: var(--accent);
        border-color: var(--accent);
      }
      .project-blurb {
        color: var(--fg);
        margin: 4px 0 10px;
        font-size: 14px;
        line-height: 1.55;
      }
      .stack {
        list-style: none; padding: 0; margin: 0;
        display: flex; flex-wrap: wrap; gap: 6px;
      }
      .stack li {
        font-size: 11px;
        color: var(--dim);
        border: 1px solid var(--rule);
        padding: 2px 6px;
        background: #0d0d0d;
      }

      /* Contacts */
      .contacts { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
      .contact {
        display: flex; gap: 10px; align-items: baseline;
        font-size: 14px;
      }
      .contact-label {
        color: var(--dim);
        min-width: 84px;
        text-transform: lowercase;
      }
      .contact-sep { color: var(--muted); }
      .contact-value { color: var(--link); }

      .foot { margin-top: 56px; }

      @media (max-width: 520px) {
        .wrap { padding: 32px 16px 64px; }
        .project-status { margin-left: 0; }
      }
    </style>
  </body>
</html>
